digraph auto_uv_efficiency_mode {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    label="Auto-UV Efficiency Mode State Machine",
    labelloc=t,
    fontsize=24,
    fontname="Arial"
  ];
  node [
    shape=box,
    style="rounded,filled",
    color="#334155",
    fillcolor="#f8fafc",
    fontname="Arial",
    fontsize=13,
    margin="0.12,0.08"
  ];
  edge [
    color="#475569",
    fontname="Arial",
    fontsize=11,
    arrowsize=0.8
  ];

  start [label="stable candidate\naccepted", shape=circle, fillcolor="#dcfce7"];
  delta [label="measure FPS/W delta\nvs previous stable"];
  improved [label="continue descent\nreset no-gain state", fillcolor="#ecfdf5"];
  arm [label="arm stop\nstore previous stable"];
  min_drop [label="check minimum\nvoltage drop"];
  too_shallow [label="continue descent\nnot deep enough", fillcolor="#ecfdf5"];
  budget [label="check OC budget"];
  try_oc [label="try efficiency-wall\nOC budget", fillcolor="#eff6ff"];
  oc_probe [label="probe recovered clock"];
  oc_accept [label="continue descent\nFPS/W improved", fillcolor="#ecfdf5"];
  confirm [label="confirm wall\nno-gain streak"];
  wait [label="continue descent\nneed confirmation", fillcolor="#ecfdf5"];
  stop_previous [label="stop at previous curve\nconfirmed regression", fillcolor="#fef9c3"];
  stop_current [label="stop at current curve\ntiny non-negative delta", fillcolor="#fef9c3"];
  end [label="return to sweep", shape=doublecircle, fillcolor="#dcfce7"];

  start -> delta;
  delta -> improved [label="FPS/W improved"];
  delta -> arm [label="no gain or power-up regression"];
  arm -> min_drop;
  min_drop -> too_shallow [label="below min drop"];
  min_drop -> budget [label="deep enough"];
  budget -> try_oc [label="budget remains"];
  budget -> confirm [label="budget spent"];
  try_oc -> oc_probe;
  oc_probe -> oc_accept [label="probe stable + FPS/W gain"];
  oc_probe -> confirm [label="rejected or no gain"];
  confirm -> wait [label="streak not reached"];
  confirm -> stop_previous [label="hard regression"];
  confirm -> stop_current [label="tiny non-negative delta"];
  improved -> end;
  too_shallow -> end;
  oc_accept -> end;
  wait -> end;
  stop_previous -> end;
  stop_current -> end;
}

