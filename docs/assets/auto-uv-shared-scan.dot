digraph auto_uv_shared_scan {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    label="Auto-UV Shared Scan State Machine",
    labelloc=t,
    fontsize=24,
    fontname="Arial"
  ];
  node [
    shape=box,
    style="rounded,filled",
    color="#334155",
    fillcolor="#f8fafc",
    fontname="Arial",
    fontsize=13,
    margin="0.12,0.08"
  ];
  edge [
    color="#475569",
    fontname="Arial",
    fontsize=11,
    arrowsize=0.8
  ];

  start [label="start", shape=circle, width=0.55, fillcolor="#dcfce7"];
  initial_check [label="initial check\nhardware + workload"];
  settings [label="normalize settings\nmode, drops, durations, budget"];
  crash [label="consume crash marker\npersist unsafe point if valid", fillcolor="#fff7ed"];
  gpu [label="open GPU APIs\nNVAPI + NVML"];
  base_curve [label="read base V/F curve\nvalidate editable bins"];
  defaults [label="restore runtime defaults\nclear stale offsets"];
  discovery [label="discovery probe\nstock loaded metrics"];
  lock [label="choose baseline lock\nstart voltage + sustained clock"];
  flatten [label="flatten baseline curve\nfixed target clock"];
  baseline [label="baseline probe\nshort stability pass"];
  baseline_ok [label="baseline accepted\nwrite latest verified", fillcolor="#ecfdf5"];
  baseline_recovery [label="baseline recovery\nsearch higher voltage", fillcolor="#eff6ff"];
  sweep [label="candidate sweep\nwalk lower voltage bins", fillcolor="#eef2ff"];
  final_choice [label="optional final choice\nUI/user selection", fillcolor="#f5f3ff"];
  final_verify [label="final verification\nlong probe"];
  final_recovery [label="final recovery\nhigher voltage if needed", fillcolor="#eff6ff"];
  save [label="save profile\narchive final curve", fillcolor="#ecfdf5"];
  abort [label="abort\nno safe curve", fillcolor="#fee2e2"];
  cleanup [label="cleanup\nrestore defaults + release locks"];
  end [label="end", shape=doublecircle, width=0.55, fillcolor="#dcfce7"];

  start -> initial_check;
  initial_check -> settings;
  settings -> crash;
  crash -> gpu;
  gpu -> base_curve;
  base_curve -> defaults;
  defaults -> discovery;
  discovery -> lock;
  lock -> flatten;
  flatten -> baseline;
  baseline -> baseline_ok [label="pass"];
  baseline -> baseline_recovery [label="fail"];
  baseline_recovery -> baseline_ok [label="higher voltage passes"];
  baseline_recovery -> abort [label="no stable baseline"];
  baseline_ok -> sweep;
  sweep -> final_choice [label="stable stop"];
  final_choice -> final_verify;
  final_verify -> save [label="pass"];
  final_verify -> final_recovery [label="recoverable fail"];
  final_recovery -> save [label="pass"];
  final_recovery -> abort [label="no final stable"];
  save -> cleanup;
  abort -> cleanup;
  cleanup -> end;
}
