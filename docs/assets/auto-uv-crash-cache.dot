digraph auto_uv_crash_cache {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    label="Auto-UV Crash Marker And Unsafe Cache State Machine",
    labelloc=t,
    fontsize=24,
    fontname="Arial"
  ];
  node [
    shape=box,
    style="rounded,filled",
    color="#334155",
    fillcolor="#f8fafc",
    fontname="Arial",
    fontsize=13,
    margin="0.12,0.08"
  ];
  edge [
    color="#475569",
    fontname="Arial",
    fontsize=11,
    arrowsize=0.8
  ];

  start [label="probe starts", shape=circle, fillcolor="#dcfce7"];
  marker [label="write in-progress marker\nphase, voltage, clock, budget"];
  running [label="probe running"];
  clean [label="clean exit\nclear marker", fillcolor="#ecfdf5"];
  crash [label="process dies\nreboot, hang, kill", fillcolor="#fee2e2"];
  next_run [label="next run\nconsume stale marker"];
  validate [label="validate crash marker\nvoltage drop + recovery pct"];
  ignore [label="ignore marker\nnot aggressive enough", fillcolor="#f8fafc"];
  unsafe [label="record unsafe point\npersistent blacklist", fillcolor="#fff7ed"];
  block [label="block future candidates\nsame/lower voltage in clock band", fillcolor="#fff7ed"];
  cap [label="cap OC budget\nif recovery probe crashed", fillcolor="#fff7ed"];
  end [label="done", shape=doublecircle, fillcolor="#dcfce7"];

  start -> marker;
  marker -> running;
  running -> clean [label="probe returns"];
  running -> crash [label="no cleanup"];
  clean -> end;
  crash -> next_run;
  next_run -> validate;
  validate -> ignore [label="fails validation"];
  validate -> unsafe [label="passes validation"];
  unsafe -> block;
  unsafe -> cap;
  ignore -> end;
  block -> end;
  cap -> end;
}

