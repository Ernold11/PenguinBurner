[Desktop Entry]
Type=Application
Name=PenguinBurner
GenericName=NVIDIA GPU Tuning Tool
Comment=Automatic NVIDIA GPU undervolting and overclocking, with three verified tiers, adaptive per-game profiles for Steam, Lutris, Heroic and Faugus, and an in-game overlay
Exec=penguin-burner
Icon=io.github.jpietek.PenguinBurner
Terminal=false
Categories=Settings;HardwareSettings;Qt;
Keywords=Penguin;Burner;Penguin Burner;PenguinBurner;penguin-burner;pburn;Nvidia;NVIDIA;GPU;Tuning;Undervolt;Undervolting;Overclock;Overclocking;Adaptive;Overlay;Auto-UV;Q2RTX;CUDA;Steam;Lutris;Heroic;Faugus;
StartupNotify=true
StartupWMClass=io.github.jpietek.PenguinBurner
Actions=ToggleOverlay;NextOverlayDetail;

[Desktop Action ToggleOverlay]
Name=Toggle overlay
Exec=penguin-burner-cli --overlay-toggle

[Desktop Action NextOverlayDetail]
Name=Next overlay detail level
Exec=penguin-burner-cli --overlay-detail-next
