#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_clean:
	rm -rf build dist *.egg-info src/*.egg-info

override_dh_auto_configure:

override_dh_auto_build:
	PENGUIN_BURNER_REQUIRE_NATIVE_LAYER=1 PENGUIN_BURNER_REQUIRE_NVAPI_SHIM=1 python3 -m build --wheel --no-isolation --skip-dependency-check

override_dh_auto_install:
	python3 -m installer --destdir=$(CURDIR)/debian/penguin-burner --prefix=/usr/lib/penguin-burner dist/*.whl
	python3 packaging/debian/install-private-python.py

override_dh_auto_test:
