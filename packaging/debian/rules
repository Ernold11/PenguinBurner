#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	PENGUIN_BURNER_REQUIRE_NATIVE_LAYER=1 python3 -m build --wheel --no-isolation

override_dh_auto_install:
	python3 -m installer --destdir=$(CURDIR)/debian/penguin-burner --prefix=/usr/lib/penguin-burner dist/*.whl
	python3 packaging/debian/install-private-python.py

override_dh_auto_test:
