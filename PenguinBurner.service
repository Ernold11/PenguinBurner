[Unit]
Description=PenguinBurner runtime daemon
After=multi-user.target

[Service]
Type=simple
# Example static unit. The preferred install path is:
#   sudo ./penguin_burner.sh --install-systemd-service
Environment=PENGUIN_BURNER_FOREGROUND=1
WorkingDirectory=/
ExecStart=/usr/bin/bash /path/to/penguin_burner.sh
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal
SyslogIdentifier=PenguinBurner

[Install]
WantedBy=multi-user.target
